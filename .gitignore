# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.eve/
/.output/
/.nitro/
/evals/agent/live-results.*
/evals/agent/results.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local vehicle databases (built by scripts/ingest.ts; epa-sample.csv IS committed)
/data/*.db
/data/*.db-*
/data/source-*.csv
/data/source-*.csv.*.tmp
/data/generation-candidate.json
/release/

# agent working docs
/docs/superpowers/

# per-agent worktrees (pnpm wt)
/.worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/evals/agent/decision-results.json
