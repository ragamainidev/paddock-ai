# All variables are read server-side only. Nothing here is ever exposed to the client.

# libSQL connection. Local dev: file DB built by `pnpm catalog:install` (public EPA) or `pnpm catalog:sample` (offline sample).
# Production: a Turso URL like libsql://paddock-<org>.turso.io
DATABASE_URL=file:data/ymm.db

# Turso auth token. Required only when DATABASE_URL is a libsql:// URL. Empty for file: URLs.
TURSO_AUTH_TOKEN=

# Postgres for run persistence + tracing (docker compose service on :5433).
# Optional: when unreachable, runs fall back to in-memory storage with a
# visible degradation note. `pnpm db:up` starts and migrates it.
POSTGRES_URL=postgres://panelgap:panelgap@localhost:5433/panelgap

# Runs the Postgres arm of the run-store contract test (src/runs/store.test.ts).
# Unset, that arm is skipped. Point it at a throwaway database; the test writes.
# POSTGRES_TEST_URL=postgres://panelgap:panelgap@localhost:5433/panelgap

# Anthropic API key. Used by the interpret stage (query → constraints) and
# complaint-theme clustering. Both degrade gracefully when absent: interpret
# falls back to the deterministic tokenizer, themes render raw complaint counts.
ANTHROPIC_API_KEY=

# eBay Browse API, client-credentials grant (no user login). Production keyset from
# https://developer.ebay.com → My Account → Keys. Listings section is skipped when absent.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# App-level auth for hosted deployments (docs/auth.md). Both required on
# Vercel; leave both unset locally to run open. AUTH_SECRET: >= 32 chars
# (`pnpm auth:secret`). AUTH_USERS: `user:hash` entries separated by commas
# (`pnpm auth:hash <user>`). Rotating AUTH_SECRET signs everyone out.
AUTH_SECRET=
AUTH_USERS=
# Session lifetime in days (1..365, default 30).
AUTH_SESSION_DAYS=30

# Persistent vehicle assessments use a separate libSQL database; never the read-only vehicle DB.
# Use the SAME durable URL/token in Next and Eve. Hosted use requires an explicit URL.
ASSESSMENTS_DATABASE_URL=file:data/assessments.db
ASSESSMENTS_AUTH_TOKEN=

# Next -> Eve bridge. Generate a random token; never expose it to browser code.
PADDOCK_AGENT_TOKEN=
# Optional. The agent is co-hosted, so the app addresses it through its own
# origin (VERCEL_URL on Vercel). Set this only for a standalone `pnpm agent:dev`
# (http://127.0.0.1:2001) or for `pnpm agent:worker`, which has no request origin.
PADDOCK_AGENT_URL=
# Optional. Required only when Vercel deployment protection is enabled, so the
# app's own server-to-server call reaches the agent instead of the challenge page.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Default fixture coordinator and recorded evidence make no provider calls.
PADDOCK_AGENT_MODE=fixture
# Opt-in live coordinator: all three settings below are required.
PADDOCK_AGENT_LIVE_ACK=
PADDOCK_AGENT_MODEL=
AI_GATEWAY_API_KEY=
# Separate opt-in for real VIN, marketplace, photo and repair sources.
# Requires live-coordinator mode above; costs also require an assessment allowance.
PADDOCK_AGENT_ALLOW_LIVE_EVIDENCE=

# Dispatch schedule (eve → Vercel Cron). Hobby allows daily only; the default is daily at 06:00 UTC.
# On Pro set '* * * * *' for minute-granularity retries and watches.
PADDOCK_DISPATCH_CRON=

# Fixed port for the `pnpm eval:agent` runtime harness. Unset, it picks a free one.
# PADDOCK_AGENT_EVAL_PORT=
# Scales that harness's wait budgets ×4 for a slow machine, as CI=true does.
# PADDOCK_AGENT_EVAL_SLOW=
# Milliseconds the fixture coordinator waits before answering (capped at 250).
# The runtime eval sets it; leave it unset everywhere else.
# PADDOCK_AGENT_FIXTURE_DELAY_MS=

# Enables POST /api/debug-run. Never set in production; the route 404s without it.
# PADDOCK_DEBUG=
